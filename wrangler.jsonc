{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "socialbrewery",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-13",
  "observability": { "enabled": true },

  // One container runs the whole Node app. Its data folder (/data) is an R2 bucket mounted with FUSE,
  // so users, organisations, encrypted keys, posts, and videos survive restarts and redeploys.
  "containers": [
    {
      "class_name": "SocialbreweryContainer",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      // The app stores files, so exactly one copy may run.
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "APP", "class_name": "SocialbreweryContainer" }]
  },
  "exports": {
    "SocialbreweryContainer": { "type": "durable-object", "storage": "sqlite" }
  },

  "vars": {
    // Public address of the app: the workers.dev URL or your custom domain. OAuth redirects start with it.
    "APP_URL": "https://socialbrewery.<your-subdomain>.workers.dev",
    "R2_ACCOUNT_ID": "<your-cloudflare-account-id>",
    "R2_BUCKET_NAME": "socialbrewery-data"
  }

  // Secrets (wrangler secret put <NAME>), never in this file:
  //   SOCIALBREWERY_MASTER_KEY   required, 32 random bytes base64 (openssl rand -base64 32)
  //   R2_ACCESS_KEY_ID           required, R2 API token with Object Read & Write on the bucket
  //   R2_SECRET_ACCESS_KEY       required
  //   GITHUB_AUTH_CLIENT_ID / GITHUB_AUTH_CLIENT_SECRET   and/or
  //   GOOGLE_AUTH_CLIENT_ID / GOOGLE_AUTH_CLIENT_SECRET
}
