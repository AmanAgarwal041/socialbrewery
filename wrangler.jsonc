{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "socialbrewery",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-13",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // The dashboard is plain static files; Cloudflare serves them without running the Worker.
  // Only API, connector, media, and webhook paths reach the Worker. Sign-in pages are Clerk's, in the dashboard.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/mcp", "/public/*", "/webhooks/*", "/.well-known/*"]
  },

  // Organisations, encrypted settings and tokens, posts, and history (one JSON document per row).
  // People, memberships, and invites are in Clerk.
  // Create it with: npx wrangler d1 create socialbrewery   then paste the database_id here.
  "d1_databases": [
    { "binding": "DB", "database_name": "socialbrewery", "database_id": "7895e062-1d60-4d12-a0a6-a821f7be7dbb" }
  ],

  // Videos. Without a bucket they are kept in D1 in pieces: at most 25 MB each, and the oldest are
  // removed once they pass 350 MB in total (D1_VIDEO_MAX_MB / D1_VIDEO_BUDGET_MB change that).
  // For bigger or more videos, use R2 (10 GB free, but Cloudflare asks for a payment method first):
  //   npx wrangler r2 bucket create socialbrewery-media   then uncomment this block.
  // "r2_buckets": [
  //   { "binding": "MEDIA", "bucket_name": "socialbrewery-media" }
  // ],

  "vars": {
    // Public address of the app: the workers.dev URL or your custom domain. OAuth redirects start with it.
    "APP_URL": "https://socialbrewery.agarwal-aman041.workers.dev",
    // The Chrome extension (extension/) signs in with this app's Clerk sessions; its id comes from the
    // key in extension/public/manifest.json.
    "CLERK_AUTHORIZED_PARTIES": "chrome-extension://lbpmjaljdakmemfoapiecnocaimlekjm"
    // Clerk's publishable key is public, so it can live here instead of in a secret:
    // "CLERK_PUBLISHABLE_KEY": "pk_live_..."
  }

  // Secrets (npx wrangler secret put <NAME>), never in this file:
  //   SOCIALBREWERY_MASTER_KEY   required, 32 random bytes base64 (openssl rand -base64 32)
  //   CLERK_SECRET_KEY           required, sk_live_... from the Clerk dashboard
  //   CLERK_PUBLISHABLE_KEY      required unless set in "vars" above
}
