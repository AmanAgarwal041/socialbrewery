{
  "manifest_version": 3,
  "name": "Socialbrewery",
  "short_name": "Socialbrewery",
  "description": "Grok or Claude writes your post, then fills it in on YouTube, LinkedIn, Instagram, X, Reddit, Slack, or Hashnode in your own tabs. Nothing goes live until you approve it.",
  "version": "0.1.0",
  "key": "",
  "minimum_chrome_version": "120",
  "action": { "default_title": "Open Socialbrewery" },
  "side_panel": { "default_path": "sidepanel.html" },
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icon-16.png", "48": "icon-48.png", "128": "icon-128.png" },
  "permissions": ["sidePanel", "storage", "unlimitedStorage", "tabs", "scripting", "debugger", "cookies"],
  "host_permissions": ["<all_urls>"]
}
