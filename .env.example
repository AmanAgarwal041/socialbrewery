# Socialbrewery server settings. Only whoever runs the server edits this file; restart after changes.
# Organisation keys (xAI, OpenAI, network apps, Grok connector) are not here: each organisation
# adds its own in Settings, and they are stored encrypted under data/orgs/<id>/.

HOST=127.0.0.1
PORT=3847
APP_URL=http://127.0.0.1:3847

# Sign-in. Configure at least one. Callback URLs: ${APP_URL}/auth/google/callback and ${APP_URL}/auth/github/callback
GOOGLE_AUTH_CLIENT_ID=
GOOGLE_AUTH_CLIENT_SECRET=
GITHUB_AUTH_CLIENT_ID=
GITHUB_AUTH_CLIENT_SECRET=

# Optional: the encryption master key (32 random bytes, base64). Without it, Socialbrewery creates
# .master.key next to this file on first start. Back it up: losing it makes stored keys unreadable.
# SOCIALBREWERY_MASTER_KEY=
