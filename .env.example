# Socialbrewery server settings. Only whoever runs the server edits this file; restart after changes.
# Organisation keys (xAI, OpenAI, network apps, Grok connector) are not here: each organisation
# adds its own in Settings, and they are stored encrypted under data/orgs/<id>/.

HOST=127.0.0.1
PORT=3847
APP_URL=http://127.0.0.1:3847

# Sign-in and organisations run on Clerk (https://dashboard.clerk.com). Create an application, turn on
# Organizations, and copy its API keys here. Members, roles, and invites are managed in Clerk.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: Clerk's PEM public key (API keys → Show JWT public key) verifies sessions without a network call.
# CLERK_JWT_KEY=
# Optional: extra origins allowed to send session tokens, comma separated (for example the Vite dev server).
# CLERK_AUTHORIZED_PARTIES=http://localhost:5173

# Optional: the encryption master key (32 random bytes, base64). Without it, Socialbrewery creates
# .master.key next to this file on first start. Back it up: losing it makes stored keys unreadable.
# SOCIALBREWERY_MASTER_KEY=
